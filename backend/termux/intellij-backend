#!/data/data/com.termux/files/usr/bin/bash
# Starts, stops and reports IntelliJ's remote-dev backend in Termux.
#
#   intellij-backend start <project> [--lan] [--port N]   start (or find) the backend; prints its join link
#   intellij-backend link                                   prints the running backend's join link
#   intellij-backend status [--json]                        running or not, project, port, join link
#   intellij-backend stop                                   stops the running backend
#   intellij-backend setup                                  one-time setup in Termux (safe to repeat)
#   intellij-backend ssh-agent start|stop|status            ssh-agent plus the bridge that lets the Ideate app use its keys
#
# Exit codes: 0 ok, 1 failed, 2 usage, 3 not running, 4 another IntelliJ uses the same settings,
# 5 the notification couldn't be shown (start only; nothing was started).
#
# One backend serves every project it has open, through one join link: `start` for a second
# project asks the running backend to open it too, as JetBrains Gateway does.
#
# The Android app calls this through Termux's RUN_COMMAND and over SSH, so the output and exit
# codes are a contract: docs/connections.md. The state comes from IntelliJ's own status files in
# ~/.cache/JetBrains/RemoteDev/active/ (one per running backend, named by its PID), the same files
# JetBrains Gateway reads over SSH.
#
# While a backend runs, Termux:API shows an ongoing notification on the "IntelliJ Backend" channel:
# starting (Cancel), running with its projects (Stop), stopping. A backend doesn't start without
# it: when the "starting" notification can't be posted, start (and a Gateway start) fails with
# exit code 5 before IntelliJ runs. Later posts only warn, so stop always goes through. `setup`
# puts a wrapper in place of IntelliJ's bin/remote-dev-server.sh, so this also happens for
# backends that JetBrains Gateway or a hand-typed `remote-dev-server.sh run` starts.
#
# IntelliJ install: $INTELLIJ_HOME, or the only ~/intellij/idea-*/ folder.

set -euo pipefail
shopt -s nullglob

readonly TERMUX_PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
readonly JBR_HOME="$TERMUX_PREFIX/lib/jvm/jbr-25"
readonly STATUS_DIR="$HOME/.cache/JetBrains/RemoteDev/active"
readonly LOG_DIR="$HOME/.local/state/intellij-backend"
readonly DEFAULT_PORT=5990
readonly START_TIMEOUT_SECONDS=180
readonly STOP_TIMEOUT_SECONDS=60
readonly NOTIFICATION_ID="intellij-backend"
readonly NOTIFICATION_CHANNEL="intellij-backend"
readonly NOTIFICATION_CHANNEL_NAME="IntelliJ Backend"
# One of Termux:API's own icons (ic_<name>_black_24dp); it can't load one from a file.
readonly NOTIFICATION_ICON="code"
# The process group of the launcher that command_run started, while it runs.
readonly LAUNCHER_PID_FILE="$LOG_DIR/launcher.pid"
readonly ANDROID_APP_ACTIVITY="io.github.safeuq.ideate.client.android/.MainActivity"
# setup moves IntelliJ's launcher here and puts a wrapper in its place.
readonly REAL_LAUNCHER_NAME="remote-dev-server.real.sh"
readonly WRAPPER_MARKER="Written by intellij-backend setup"
readonly FSNOTIFIER_PATH="$HOME/intellij/fsnotifier"
# ssh-agent and ssh-agent-bridge (docs/ssh-agent-bridge.md): a fixed socket, so the Ideate app
# and the shell profile always know where the agent is. Each program has a pid file next to it.
readonly AGENT_RUN_DIR="$TERMUX_PREFIX/var/run/intellij-backend"
readonly AGENT_SOCKET="$AGENT_RUN_DIR/ssh-agent.sock"
readonly AGENT_PID_FILE="$AGENT_RUN_DIR/ssh-agent.pid"
readonly BRIDGE_PID_FILE="$AGENT_RUN_DIR/agent-bridge.pid"

# Every IntelliJ command here (run and stop) needs our bionic JBR: IntelliJ's bundled JBR is
# built for glibc and fails at once (/lib/ld-linux-aarch64.so.1: not found). Set here, not in
# the shell profile, because Termux's RUN_COMMAND doesn't read one.
export IDEA_JDK="$JBR_HOME"
export REMOTE_DEV_SERVER_USE_SELF_CONTAINED_LIBS=0
# Android has no writable /tmp; Termux sets TMPDIR in its own sessions, not always elsewhere.
export TMPDIR="${TMPDIR:-$TERMUX_PREFIX/tmp}"

readonly EXIT_FAILED=1
readonly EXIT_USAGE=2
readonly EXIT_NOT_RUNNING=3
readonly EXIT_CONFLICT=4
readonly EXIT_NO_NOTIFICATION=5

fail() {
	local -r exit_code="$1"
	shift
	echo "intellij-backend: $*" >&2
	exit "$exit_code"
}

usage() {
	sed -n '4,9s/^# \{0,1\}//p' "$0" >&2
	exit "$EXIT_USAGE"
}

intellij_launcher() {
	local intellij_home="${INTELLIJ_HOME:-}"
	if [[ -z "$intellij_home" ]]; then
		local -a candidates=("$HOME"/intellij/idea-*/)
		if [[ ${#candidates[@]} -ne 1 ]]; then
			fail "$EXIT_FAILED" "found ${#candidates[@]} IntelliJ installs under ~/intellij; set INTELLIJ_HOME to one"
		fi
		intellij_home="${candidates[0]%/}"
	fi
	local -r launcher="$intellij_home/bin/remote-dev-server.sh"
	[[ -x "$launcher" ]] || fail "$EXIT_FAILED" "not an IntelliJ install (no bin/remote-dev-server.sh): $intellij_home"
	echo "$launcher"
}

# Whether process $1 exists. A process started over adb run-as (SELinux domain runas_app) exists
# but is hidden from Termux's own side (untrusted_app: the app, Termux sessions, sshd): its /proc
# entry gives "Permission denied" where a process that is gone gives "No such file". See
# docs/running-the-backend.md, "Don't start the backend with adb run-as".
process_exists() {
	[[ -d "/proc/$1" ]] || [[ "$(LC_ALL=C ls -d "/proc/$1" 2>&1)" == *"Permission denied"* ]]
}

# Prints the status file of the running backend, if any. Files whose process is gone (a crash
# leaves them behind) don't count.
running_status_file() {
	local status_file
	for status_file in "$STATUS_DIR"/*; do
		if process_exists "$(basename "$status_file")" && jq -e '.joinLink' "$status_file" >/dev/null 2>&1; then
			echo "$status_file"
			return
		fi
	done
}

# The join link written when the backend started. Valid until the first client connects with it.
join_link_of() {
	jq -r '.joinLink' "$1"
}

# A join token works once: when a client connects with it, the backend issues a new one, but the
# status file keeps the old one. So ask the backend itself with IntelliJ's status command (about
# 1.5 s; it doesn't use up the token). Prints its JSON: joinLink, projects[].controllerConnected.
live_status_json() {
	local -r status_file="$1"
	local output
	output="$(timeout 30 "$(intellij_launcher)" status "$(project_of "$status_file")" 2>/dev/null)" || true
	output="$(sed -n '/^{/,/^}/p' <<<"$output")"
	jq -e '.joinLink' <<<"$output" >/dev/null 2>&1 \
		|| fail "$EXIT_FAILED" "the backend (pid $(basename "$status_file")) didn't answer IntelliJ's status command"
	echo "$output"
}

# Whether the running backend has $2 open: IntelliJ's status lists every open project.
has_project() {
	local -r live_status="$1" project="$2"
	jq -e --arg project "$project" 'any(.projects[]?; .projectPath == $project)' <<<"$live_status" >/dev/null
}

# Opens $2 in the backend that is already running ($1 its status file), as Gateway does for a
# second project: IntelliJ's launcher `run <project>` hands the project to the running instance
# and exits at once. Waits until the backend lists it, then prints the join link (the same one
# for every project).
open_in_running_backend() {
	local -r status_file="$1" project="$2"
	local -r log_file="$LOG_DIR/open-$(date +%Y%m%d-%H%M%S).log"
	mkdir -p "$LOG_DIR"
	# INTELLIJ_BACKEND_RUN: past our launcher wrapper, so this short-lived run doesn't take the
	# wake lock or remove the notification of the backend that is already running.
	INTELLIJ_BACKEND_RUN=1 timeout 60 "$(intellij_launcher)" run "$project" </dev/null >"$log_file" 2>&1 \
		|| fail "$EXIT_FAILED" "IntelliJ's launcher didn't hand $project to the running backend; log: $log_file"
	local waited_seconds=0 live_status
	while [[ $waited_seconds -lt $START_TIMEOUT_SECONDS ]]; do
		live_status="$(live_status_json "$status_file")"
		if has_project "$live_status" "$project"; then
			show_notification running "$live_status" || true
			jq -r '.joinLink' <<<"$live_status"
			return
		fi
		sleep 2
		waited_seconds=$((waited_seconds + 2))
	done
	fail "$EXIT_FAILED" "the running backend didn't open $project within ${START_TIMEOUT_SECONDS}s; log: $log_file"
}

project_of() {
	jq -r '.gatewayLink | capture("projectPath=(?<path>[^&]+)").path | @urid' "$1"
}

# Any IntelliJ JVM: a backend, or the desktop IntelliJ in XFCE. They share the config and
# system folders, so only one can run.
other_intellij_pid() {
	pgrep -f 'com\.intellij\.idea\.Main' | head -n 1 || true
}

# The notification has its own channel, so it can be silenced or hidden on its own in Android's
# settings. Not with termux-notification-channel: it doesn't quote the name, so "IntelliJ Backend"
# would become "IntelliJ". Creating it again only renames it, so it's done before every post.
create_notification_channel() {
	timeout 10 "$TERMUX_PREFIX/libexec/termux-api" NotificationChannel \
		--es id "$NOTIFICATION_CHANNEL" \
		--es name "$NOTIFICATION_CHANNEL_NAME" \
		>/dev/null 2>&1 || true
}

# $1: starting, running or stopping; for running, $2 is the live status (its open projects).
# Termux:API has no progress bar (termux/termux-api#600), so starting and stopping end in "...".
# Its status-bar icon can only be one of its own (Material) icons. No large icon: --image-path
# also shows the picture big when the notification is expanded. termux-notification waits forever
# when the Termux:API app is missing, hence the timeouts.
#
# Returns 1, with the reason on stderr, when the notification isn't showing afterwards.
# termux-notification's exit code proves nothing (0 also when nothing was posted), so the post is
# read back with termux-notification-list, which needs Termux:API's notification access.
show_notification() {
	local -r state="$1"
	local title content="" button=""
	case "$state" in
		starting)
			title="IntelliJ IDE Backend is starting..."
			content="This may take a few minutes"
			button="Cancel"
			;;
		running)
			title="IntelliJ IDE Backend is running"
			content="$(jq -r '[.projects[]?.projectPath | split("/") | last] | join(", ")' <<<"$2")"
			content="Projects: ${content:-none}"
			button="Stop"
			;;
		stopping) title="IntelliJ IDE Backend is stopping..." ;;
		*) fail "$EXIT_FAILED" "unknown notification state: $state" ;;
	esac
	local -a options=()
	if [[ -n "$button" ]]; then
		options+=(--button1 "$button" --button1-action "$TERMUX_PREFIX/bin/intellij-backend stop")
	fi
	if ! command -v termux-notification >/dev/null; then
		echo "intellij-backend: the termux-api package is missing: pkg install termux-api" >&2
		return 1
	fi
	create_notification_channel
	local post_exit_code=0
	timeout 10 termux-notification \
		--id "$NOTIFICATION_ID" \
		--channel "$NOTIFICATION_CHANNEL" \
		--ongoing \
		--alert-once \
		--priority low \
		--icon "$NOTIFICATION_ICON" \
		--title "$title" \
		--content "$content" \
		--action "am start -n $ANDROID_APP_ACTIVITY; $TERMUX_PREFIX/bin/intellij-backend internal-notify" \
		"${options[@]}" \
		>/dev/null 2>&1 || post_exit_code=$?
	if [[ $post_exit_code -eq 124 ]]; then
		echo "intellij-backend: Termux:API didn't answer within 10 s: install the Termux:API app (same source as Termux) and open it once" >&2
		return 1
	elif [[ $post_exit_code -ne 0 ]]; then
		echo "intellij-backend: termux-notification failed (exit code $post_exit_code)" >&2
		return 1
	fi
	notification_is_showing "$title" && return 0
	echo "intellij-backend: the notification \"$title\" isn't showing after posting it (termux-notification-list doesn't list it). Check that Termux:API may post notifications and has notification access (Android settings)" >&2
	return 1
}

# Whether our notification shows title $1. Android may take a moment to list a new post.
notification_is_showing() {
	local -r title="$1"
	local attempt listed
	for attempt in 1 2 3; do
		listed="$(timeout 10 termux-notification-list 2>/dev/null)" || listed=""
		if jq -e --arg tag "$NOTIFICATION_ID" --arg title "$title" \
			'any(.[]?; .tag == $tag and .title == $title)' <<<"$listed" >/dev/null 2>&1; then
			return 0
		fi
		sleep 1
	done
	return 1
}

# Termux:API dismisses its notifications when tapped (setAutoCancel(true), always), so tapping
# opens the app and then posts the notification again: running with the projects open now, or
# starting while the launcher hasn't written its status file yet.
repost_notification() {
	local -r status_file="$(running_status_file)"
	local live_status
	if [[ -n "$status_file" ]] && live_status="$(live_status_json "$status_file" 2>/dev/null)"; then
		show_notification running "$live_status" || true
	elif [[ -f "$LAUNCHER_PID_FILE" && -n "$(<"$LAUNCHER_PID_FILE")" ]] && process_exists "$(<"$LAUNCHER_PID_FILE")"; then
		show_notification starting || true
	fi
}

# Shows "running" once the backend answers and, given a project ($1), lists it.
show_running_when_listed() {
	local -r project="${1:-}"
	local waited_seconds=0 status_file live_status
	while [[ $waited_seconds -lt $START_TIMEOUT_SECONDS ]]; do
		status_file="$(running_status_file)"
		if [[ -n "$status_file" ]] && live_status="$(live_status_json "$status_file" 2>/dev/null)" \
			&& { [[ -z "$project" ]] || has_project "$live_status" "$project"; }; then
			show_notification running "$live_status" || true
			return
		fi
		sleep 2
		waited_seconds=$((waited_seconds + 2))
	done
}

release_backend_resources() {
	timeout 10 termux-notification-remove "$NOTIFICATION_ID" >/dev/null 2>&1 || true
	termux-wake-unlock 2>/dev/null || true
}

# The backend's parent, for every way it starts (start, the launcher wrapper for Gateway or by
# hand): takes the wake lock, shows "starting", runs IntelliJ's launcher, shows "running" once the
# backend answers, waits for the launcher, then removes the notification and releases the wake
# lock. The launcher outlives IntelliJ's own restarts (exit code 88 starts a new JVM) and exits
# only when the backend is gone for good: stop, crash, or killed by Android.
command_run() {
	[[ $# -ge 1 ]] || usage
	local -r launcher="$1"
	shift
	# Tells the launcher wrapper that this is already the parent.
	export INTELLIJ_BACKEND_RUN=1
	# A second project for the running backend (Gateway, or `run` by hand): the launcher hands it
	# over and exits at once. The backend keeps its wake lock and notification; the notification
	# then lists the new project too.
	if [[ -n "$(running_status_file)" ]]; then
		"$launcher" run "$@" || true
		if [[ $# -ge 1 && "$1" != -* && -d "$1" ]]; then
			setsid "$0" internal-notify "$(realpath "$1")" </dev/null >/dev/null 2>&1 &
		fi
		return 0
	fi
	# No backend without its notification (and its Cancel button): fail before IntelliJ runs.
	# For a Gateway start this is the launcher's exit code.
	show_notification starting || exit "$EXIT_NO_NOTIFICATION"
	# Keeps Android from suspending Termux while the screen is off.
	termux-wake-lock 2>/dev/null || true
	mkdir -p "$LOG_DIR"
	# Its own process group, so that stop (the notification's Cancel) can end the launcher and its
	# JVM before the backend has written its status file.
	setsid "$launcher" run "$@" &
	local -r launcher_pid=$!
	echo "$launcher_pid" >"$LAUNCHER_PID_FILE"
	show_running_when_listed &
	local -r notifier_pid=$!
	wait "$launcher_pid" || true
	kill "$notifier_pid" 2>/dev/null || true
	rm -f "$LAUNCHER_PID_FILE"
	release_backend_resources
}

# In place of IntelliJ's bin/remote-dev-server.sh: sets our JBR for every command (Gateway runs
# status, registerBackendLocationForGateway and others too) and sends `run` through
# `intellij-backend internal-run`. Rewritten on every setup; a launcher without the marker is
# IntelliJ's own (a fresh or updated install) and is moved aside first.
install_launcher_wrapper() {
	local -r intellij_bin="$1"
	local -r launcher="$intellij_bin/remote-dev-server.sh"
	if ! grep -qF "$WRAPPER_MARKER" "$launcher"; then
		mv "$launcher" "$intellij_bin/$REAL_LAUNCHER_NAME"
	fi
	[[ -x "$intellij_bin/$REAL_LAUNCHER_NAME" ]] || fail "$EXIT_FAILED" "IntelliJ's launcher is missing: $intellij_bin/$REAL_LAUNCHER_NAME"
	cat >"$launcher" <<EOF
#!$TERMUX_PREFIX/bin/sh
# $WRAPPER_MARKER (backend/termux/intellij-backend in intellij-backend-android).
# IntelliJ's own launcher is $REAL_LAUNCHER_NAME next to this file. This sets the Android JBR for
# every command, and runs "run" under intellij-backend, which shows the notification while the
# backend runs.
export IDEA_JDK="$JBR_HOME"
export REMOTE_DEV_SERVER_USE_SELF_CONTAINED_LIBS=0
export TMPDIR="\${TMPDIR:-$TERMUX_PREFIX/tmp}"
export REMOTE_DEV_LAUNCHER_NAME_FOR_USAGE="\${REMOTE_DEV_LAUNCHER_NAME_FOR_USAGE:-remote-dev-server.sh}"
real_launcher="\$(dirname "\$0")/$REAL_LAUNCHER_NAME"
if [ "\${1:-}" = run ] && [ -z "\${INTELLIJ_BACKEND_RUN:-}" ]; then
	shift
	exec "$TERMUX_PREFIX/bin/intellij-backend" internal-run "\$real_launcher" "\$@"
fi
exec "\$real_launcher" "\$@"
EOF
	chmod 755 "$launcher"
	echo "IntelliJ's launcher wrapped: $launcher"
}

use_android_fsnotifier() {
	local -r intellij_home="$1"
	if [[ ! -x "$FSNOTIFIER_PATH" ]]; then
		echo "No $FSNOTIFIER_PATH: IntelliJ will find file changes by rescanning (see docs/fsnotifier.md)"
		return
	fi
	local -r data_directory_name="$(jq -r '.dataDirectoryName' "$intellij_home/product-info.json")"
	local -r properties_file="$HOME/.config/JetBrains/$data_directory_name/idea.properties"
	local -r property="idea.filewatcher.executable.path=$FSNOTIFIER_PATH"
	mkdir -p "$(dirname "$properties_file")"
	touch "$properties_file"
	if ! grep -qxF "$property" "$properties_file"; then
		sed -i '/^idea\.filewatcher\.executable\.path=/d' "$properties_file"
		echo "$property" >>"$properties_file"
	fi
	echo "File watcher: $FSNOTIFIER_PATH (in $properties_file)"
}

# Lets Gateway over SSH use this install instead of downloading its own (glibc) IntelliJ. IntelliJ's
# command exits with an error when the install is already registered, so check its links first.
register_with_gateway() {
	local -r launcher="$1" intellij_home="$2"
	local link
	for link in "$HOME/.cache/JetBrains/RemoteDev/userProvidedDist"/*; do
		if [[ "$(readlink "$link")" == "$intellij_home" ]]; then
			echo "Registered with JetBrains Gateway: $intellij_home"
			return
		fi
	done
	"$launcher" registerBackendLocationForGateway >/dev/null 2>&1 \
		|| fail "$EXIT_FAILED" "registerBackendLocationForGateway failed; run it by hand to see why: $launcher registerBackendLocationForGateway"
	echo "Registered with JetBrains Gateway: $intellij_home"
}

command_setup() {
	[[ $# -eq 0 ]] || usage
	[[ -x "$JBR_HOME/bin/java" ]] || fail "$EXIT_FAILED" "jbr-25 is not installed ($JBR_HOME): apt install ./jbr-25_*_aarch64.deb"
	local -a missing_packages=()
	command -v jq >/dev/null || missing_packages+=(jq)
	command -v termux-notification >/dev/null || missing_packages+=(termux-api)
	if [[ ${#missing_packages[@]} -gt 0 ]]; then
		echo "Installing ${missing_packages[*]}"
		pkg install -y "${missing_packages[@]}"
	fi
	local -r launcher="$(intellij_launcher)"
	local -r intellij_bin="$(dirname "$launcher")"
	local -r intellij_home="$(dirname "$intellij_bin")"

	install_launcher_wrapper "$intellij_bin"
	use_android_fsnotifier "$intellij_home"
	register_with_gateway "$launcher" "$intellij_home"
	create_notification_channel
	echo "Notification channel: $NOTIFICATION_CHANNEL_NAME"

	echo
	echo "Left to you (Android settings this script can't change):"
	if ! grep -qE '^[[:space:]]*allow-external-apps[[:space:]]*=[[:space:]]*true' "$HOME/.termux/termux.properties" 2>/dev/null; then
		echo "- For the Android app: allow-external-apps = true in ~/.termux/termux.properties, then termux-reload-settings"
	fi
	echo "- Termux and Termux:API: battery usage Unrestricted (Termux asks the first time it takes a wake lock)"
	echo "- Android 14+: Developer options > Disable child process restrictions, so Android doesn't kill the backend"
	echo "- Termux:API app installed (F-Droid or GitHub, same source as Termux), allowed to post notifications and"
	echo "  given notification access: start fails (exit code 5) when it can't show and read back its notification"
}

command_start() {
	local project="" listen_address="127.0.0.1" port="$DEFAULT_PORT"
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--lan) listen_address="0.0.0.0" ;;
			--port)
				[[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || fail "$EXIT_USAGE" "--port needs a number"
				port="$2"
				shift
				;;
			-*) usage ;;
			*)
				[[ -z "$project" ]] || usage
				project="$1"
				;;
		esac
		shift
	done
	[[ -n "$project" ]] || usage
	[[ -d "$project" ]] || fail "$EXIT_FAILED" "project folder not found: $project"
	project="$(realpath "$project")"
	[[ -x "$JBR_HOME/bin/java" ]] || fail "$EXIT_FAILED" "jbr-25 is not installed ($JBR_HOME)"
	local -r launcher="$(intellij_launcher)"

	local status_file
	status_file="$(running_status_file)"
	# IntelliJ rewrites its status file when it opens or closes a project; read halfway through,
	# the running backend looks like "another IntelliJ" (seen 2026-11-19). Look again first.
	local attempt
	for attempt in 1 2 3; do
		[[ -z "$status_file" && -n "$(other_intellij_pid)" ]] || break
		sleep 1
		status_file="$(running_status_file)"
	done
	if [[ -n "$status_file" ]]; then
		local live_status
		live_status="$(live_status_json "$status_file")"
		if has_project "$live_status" "$project"; then
			jq -r '.joinLink' <<<"$live_status"
			return
		fi
		open_in_running_backend "$status_file" "$project"
		return
	fi
	local -r other_pid="$(other_intellij_pid)"
	[[ -z "$other_pid" ]] || fail "$EXIT_CONFLICT" "another IntelliJ is running (pid $other_pid), e.g. the desktop IntelliJ"

	# Checked here too, so the reason reaches the caller's stderr rather than only the log.
	if ! show_notification starting; then
		timeout 10 termux-notification-remove "$NOTIFICATION_ID" >/dev/null 2>&1 || true
		fail "$EXIT_NO_NOTIFICATION" "not started: the backend's notification couldn't be shown"
	fi

	mkdir -p "$LOG_DIR"
	local -r log_file="$LOG_DIR/backend-$(date +%Y%m%d-%H%M%S).log"
	# setsid: its own session, so it outlives the SSH session or Termux command that started it.
	setsid "$0" internal-run "$launcher" "$project" --listenOn "$listen_address" --port "$port" \
		</dev/null >"$log_file" 2>&1 &
	local -r launcher_pid=$!

	local waited_seconds=0
	while [[ $waited_seconds -lt $START_TIMEOUT_SECONDS ]]; do
		status_file="$(running_status_file)"
		if [[ -n "$status_file" && "$(project_of "$status_file")" == "$project" ]]; then
			join_link_of "$status_file"
			return
		fi
		if ! kill -0 "$launcher_pid" 2>/dev/null; then
			tail -n 20 "$log_file" >&2
			fail "$EXIT_FAILED" "the backend exited during startup; log: $log_file"
		fi
		sleep 2
		waited_seconds=$((waited_seconds + 2))
	done
	# Nothing half-started is left behind.
	command_stop >/dev/null 2>&1 || true
	# The whole process group: our parent, IntelliJ's launcher and its JVM.
	kill -- "-$launcher_pid" 2>/dev/null || true
	fail "$EXIT_FAILED" "no join link after ${START_TIMEOUT_SECONDS}s; stopped it. Log: $log_file"
}

command_link() {
	[[ $# -eq 0 ]] || usage
	local -r status_file="$(running_status_file)"
	[[ -n "$status_file" ]] || fail "$EXIT_NOT_RUNNING" "no backend is running"
	local live_status
	live_status="$(live_status_json "$status_file")"
	jq -r '.joinLink' <<<"$live_status"
}

command_status() {
	local json=false
	case "${1:-}" in
		--json) json=true ;;
		"") ;;
		*) usage ;;
	esac
	local -r status_file="$(running_status_file)"
	if [[ -z "$status_file" ]]; then
		if $json; then echo '{"running":false}'; else echo "not running"; fi
		return
	fi
	local live_status
	live_status="$(live_status_json "$status_file")"
	local -r join_link="$(jq -r '.joinLink' <<<"$live_status")"
	# A backend takes one client at a time: a new one with a valid token disconnects this one.
	local -r controller_connected="$(jq '[.projects[]?.controllerConnected] | any' <<<"$live_status")"
	local -r project="$(project_of "$status_file")"
	# Every open project; `project` above is the one the backend started with.
	local -r projects="$(jq -c '[.projects[]? | {projectPath, controllerConnected}]' <<<"$live_status")"
	# tcp://127.0.0.1:5990#jt=… → 127.0.0.1, 5990
	[[ "$join_link" =~ ^[a-z-]+://([^:/#]+):([0-9]+) ]] || fail "$EXIT_FAILED" "unexpected join link in $status_file"
	local -r listen_address="${BASH_REMATCH[1]}" port="${BASH_REMATCH[2]}"
	if $json; then
		jq -cn \
			--arg project "$project" \
			--argjson port "$port" \
			--arg listenOn "$listen_address" \
			--arg joinLink "$join_link" \
			--argjson controllerConnected "$controller_connected" \
			--argjson projects "$projects" \
			'{running: true, project: $project, port: $port, listenOn: $listenOn, joinLink: $joinLink, controllerConnected: $controllerConnected, projects: $projects}'
	else
		echo "running: $project on $listen_address:$port (pid $(basename "$status_file")); client connected: $controller_connected"
		jq -r '.[] | "  open: \(.projectPath)"' <<<"$projects"
		echo "$join_link"
	fi
}

command_stop() {
	[[ $# -eq 0 ]] || usage
	local -r status_file="$(running_status_file)"
	if [[ -z "$status_file" && -f "$LAUNCHER_PID_FILE" ]]; then
		# Still starting (no status file yet): end the launcher's process group, see command_run.
		local -r launcher_pid="$(<"$LAUNCHER_PID_FILE")"
		if process_exists "$launcher_pid"; then
			show_notification stopping || true
			echo "Cancelling the backend that is starting (launcher pid $launcher_pid)" >&2
			kill -- "-$launcher_pid" 2>/dev/null || true
		fi
	fi
	if [[ -n "$status_file" ]]; then
		local -r backend_pid="$(basename "$status_file")"
		local -r project="$(project_of "$status_file")"
		show_notification stopping || true
		echo "Stopping the backend for $project (pid $backend_pid)" >&2
		# IntelliJ's own stop: asks the backend to save and exit.
		local stop_output
		if ! stop_output="$("$(intellij_launcher)" stop "$project" 2>&1)"; then
			echo "$stop_output" | tail -n 5 >&2
			echo "IntelliJ's stop command failed; waiting ${STOP_TIMEOUT_SECONDS}s, then ending the process" >&2
		fi
		local waited_seconds=0
		while process_exists "$backend_pid" && [[ $waited_seconds -lt $STOP_TIMEOUT_SECONDS ]]; do
			sleep 1
			waited_seconds=$((waited_seconds + 1))
		done
		if process_exists "$backend_pid"; then
			echo "Still running after ${STOP_TIMEOUT_SECONDS}s; sending SIGTERM" >&2
			kill "$backend_pid" 2>/dev/null || true
			sleep 5
			! process_exists "$backend_pid" || fail "$EXIT_FAILED" "backend (pid $backend_pid) did not stop"
		fi
	fi
	release_backend_resources
}

# Whether pid file $1 names a live process of program $2 (its command line contains $2), so a
# pid that Android has reused for something else is never signalled. Prints the pid if so.
program_pid() {
	local -r pid_file="$1" program="$2"
	[[ -f "$pid_file" ]] || return 0
	local -r pid="$(<"$pid_file")"
	[[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] || return 0
	if tr '\0' ' ' <"/proc/$pid/cmdline" | grep -qF "$program"; then
		echo "$pid"
	fi
}

# Exit code of `ssh-add -l` against our socket: 0 keys held, 1 agent running without keys, 2 no agent.
agent_state() {
	local exit_code=0
	SSH_AUTH_SOCK="$AGENT_SOCKET" ssh-add -l >/dev/null 2>&1 || exit_code=$?
	echo "$exit_code"
}

command_ssh_agent_start() {
	command -v ssh-agent >/dev/null && command -v ssh-add >/dev/null || fail "$EXIT_FAILED" "ssh-agent or ssh-add is missing: pkg install openssh"
	command -v ssh-agent-bridge >/dev/null \
		|| fail "$EXIT_FAILED" "ssh-agent-bridge is not installed: apt install ./ssh-agent-bridge_*_aarch64.deb (docs/ssh-agent-bridge.md)"
	mkdir -p "$AGENT_RUN_DIR" "$LOG_DIR"
	chmod 700 "$AGENT_RUN_DIR"

	if [[ "$(agent_state)" == 2 ]]; then
		# Nothing answers on the socket: a file left by a crashed agent is stale.
		rm -f "$AGENT_SOCKET" "$AGENT_PID_FILE"
		local agent_output
		agent_output="$(ssh-agent -s -a "$AGENT_SOCKET")" || fail "$EXIT_FAILED" "ssh-agent didn't start on $AGENT_SOCKET"
		[[ "$agent_output" =~ SSH_AGENT_PID=([0-9]+) ]] || fail "$EXIT_FAILED" "ssh-agent printed no pid: $agent_output"
		echo "${BASH_REMATCH[1]}" >"$AGENT_PID_FILE"
		echo "ssh-agent started (pid ${BASH_REMATCH[1]}) on $AGENT_SOCKET"
	else
		echo "ssh-agent already running on $AGENT_SOCKET"
	fi

	local bridge_pid
	bridge_pid="$(program_pid "$BRIDGE_PID_FILE" ssh-agent-bridge)"
	if [[ -n "$bridge_pid" ]]; then
		echo "ssh-agent-bridge already running (pid $bridge_pid)"
	else
		local -r bridge_log="$LOG_DIR/agent-bridge.log"
		setsid ssh-agent-bridge --agent "$AGENT_SOCKET" </dev/null >>"$bridge_log" 2>&1 &
		bridge_pid=$!
		echo "$bridge_pid" >"$BRIDGE_PID_FILE"
		sleep 1
		if [[ -z "$(program_pid "$BRIDGE_PID_FILE" ssh-agent-bridge)" ]]; then
			tail -n 5 "$bridge_log" >&2
			rm -f "$BRIDGE_PID_FILE"
			fail "$EXIT_FAILED" "ssh-agent-bridge exited at once; log: $bridge_log"
		fi
		echo "ssh-agent-bridge started (pid $bridge_pid), log: $bridge_log"
	fi

	echo
	echo "Add a key:        SSH_AUTH_SOCK=$AGENT_SOCKET ssh-add"
	echo "Use it in shells: add this line to your shell profile (~/.zshrc or ~/.bashrc)"
	echo "                  export SSH_AUTH_SOCK=$AGENT_SOCKET"
}

# Stops only what this command started, and only when the pid still belongs to that program.
command_ssh_agent_stop() {
	local pid
	pid="$(program_pid "$BRIDGE_PID_FILE" ssh-agent-bridge)"
	if [[ -n "$pid" ]]; then
		kill "$pid"
		echo "ssh-agent-bridge stopped (pid $pid)"
	fi
	rm -f "$BRIDGE_PID_FILE"
	pid="$(program_pid "$AGENT_PID_FILE" ssh-agent)"
	if [[ -n "$pid" ]]; then
		kill "$pid"
		echo "ssh-agent stopped (pid $pid)"
	fi
	rm -f "$AGENT_PID_FILE" "$AGENT_SOCKET"
}

command_ssh_agent_status() {
	local -r bridge_pid="$(program_pid "$BRIDGE_PID_FILE" ssh-agent-bridge)"
	if [[ -n "$bridge_pid" ]]; then echo "bridge: running (pid $bridge_pid)"; else echo "bridge: not running"; fi
	local -r state="$(agent_state)"
	case "$state" in
		0) echo "agent: running on $AGENT_SOCKET, keys: $(SSH_AUTH_SOCK="$AGENT_SOCKET" ssh-add -l | wc -l | tr -d ' ')" ;;
		1) echo "agent: running on $AGENT_SOCKET, keys: 0" ;;
		*) echo "agent: not running" ;;
	esac
}

command_ssh_agent() {
	[[ $# -eq 1 ]] || usage
	case "$1" in
		start) command_ssh_agent_start ;;
		stop) command_ssh_agent_stop ;;
		status) command_ssh_agent_status ;;
		*) usage ;;
	esac
}

main() {
	[[ $# -ge 1 ]] || usage
	local -r command="$1"
	shift
	# setup installs jq itself.
	[[ "$command" == setup ]] || command -v jq >/dev/null || fail "$EXIT_FAILED" "jq is required: pkg install jq (or run intellij-backend setup)"
	case "$command" in
		start) command_start "$@" ;;
		link) command_link "$@" ;;
		status) command_status "$@" ;;
		stop) command_stop "$@" ;;
		setup) command_setup "$@" ;;
		ssh-agent) command_ssh_agent "$@" ;;
		# internal: started by start, see command_run
		internal-run) command_run "$@" ;;
		# internal: started by command_run for a second project
		# internal: started by command_run for a second project (with it), and by tapping the
		# notification (without)
		internal-notify) if [[ $# -eq 0 ]]; then repost_notification; else show_running_when_listed "$@"; fi ;;
		-h | --help | help) usage ;;
		*) usage ;;
	esac
}

main "$@"
